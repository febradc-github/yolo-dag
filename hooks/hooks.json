{
  "description": "meter: local, zero-network token accounting and cost reduction for yolo-dag. SessionStart boots the daemon; SubagentStart/Stop attribute spend, deliver context packs, and validate receipts; PreToolUse has four non-overlapping entries (Agent, Read|Grep|Glob, Write, and a matcher-less Governor counter) \u2014 deliberately non-overlapping to avoid the documented updatedInput/multiple-matcher hazard; PostToolUse compresses oversized output and maintains the Grep cache; SessionEnd does main-thread accounting and daemon refcounting. Per-module scope, defaults, and the reasoning behind each one live in meter/config.py and each module's docstring; the milestone specs are meter-handoff.md and meter-v2-handoff.md. Auth: export DAG_METER_TOKEN matching ${CLAUDE_PLUGIN_DATA}/meter/token; requests without it are still processed (see meter/daemon.py for why that is safe).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/meter-boot.py"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/subagent/start",
            "timeout": 10,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/tool/pre-agent",
            "timeout": 10,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/tool/pre-dossier",
            "timeout": 5,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/tool/pre-throttle",
            "timeout": 5,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/tool/pre-governor",
            "timeout": 5,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Grep|Write|Edit",
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/tool/post",
            "timeout": 5,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47615/subagent/stop",
            "timeout": 20,
            "headers": {
              "X-Dag-Meter-Token": "$DAG_METER_TOKEN"
            },
            "allowedEnvVars": [
              "DAG_METER_TOKEN"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/meter-hook.py",
              "sessionend"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
